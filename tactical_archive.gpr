with "config/tactical_archive_config.gpr";
project Tactical_Archive is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Tactical_Archive_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("tactical_archive.adb", "tactical_folder_test.adb", "tactical_mfd_cockpit.adb");

   package Compiler is
      for Default_Switches ("Ada") use Tactical_Archive_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Tactical_Archive;
